# Append these to api/.env; retain your existing MONGODB_URI and other settings.
MQTT_URL=mqtts://213.199.35.129:8883
MQTT_USERNAME=sensor-server
MQTT_PASSWORD=REPLACE_WITH_SERVER_PASSWORD
MQTT_CLIENT_ID=demo-sensor-server
# Absolute path; leave unset for a publicly trusted broker certificate.
MQTT_CA_FILE=/etc/mosquitto/certs/ca.crt
